# CORS Configuration
# Allowed frontend origin(s). Comma-separated for multiple origins.
# Default (dev): http://localhost:5173
# Examples:
#   ALLOWED_ORIGINS=http://localhost:5173
#   ALLOWED_ORIGINS=https://example.vercel.app,https://example.huggingface.co
ALLOWED_ORIGINS=http://localhost:5173

# JWT Secret Key for authentication tokens
# Change this to a strong random string in production!
JWT_SECRET=crowdflow-ai-change-me-in-production

# Server Port
PORT=8000

# Hugging Face API Token
# Used for ML congestion risk prediction model
# Get one at: https://huggingface.co/settings/tokens
# If omitted, predictions fall back to deterministic linear extrapolation
# HF_TOKEN=hf_your_token_here
# HF_MODEL_ID=crowdflow-ai/congestion-risk-classifier

# Database Settings (Optional - Defaults to SQLite if not set)
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/crowdflow_db

# Frontend Client Settings
VITE_API_URL=http://localhost:8000
